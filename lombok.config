# 이 디렉터리가 lombok 설정의 루트다. 상위 폴더를 더 뒤지지 않는다.
config.stopBubbling = true

# ★ @Qualifier 를 생성자 파라미터로 복사한다.
#
# Lombok 의 @RequiredArgsConstructor 는 필드에 붙은 애노테이션을 생성자 파라미터로
# 옮기지 않는다. 기본 복사 목록에 @Qualifier 가 없어서, 아래 설정이 없으면
#
#     @Qualifier("anthropicRestClient")
#     private final RestClient restClient;
#
# 라고 써도 생성자에는 한정자가 안 붙고 Spring 이 @Primary 빈을 넣는다.
# 컴파일도 되고 부팅도 되기 때문에 조용히 틀린 빈이 주입된다.
#
# 실제로 이것 때문에 조언 호출(Claude)이 모델용 RestClient(read-timeout 30초)를
# 쓰고 있었다. 의도는 60초였다.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
